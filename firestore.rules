rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 24 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidOfficerProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.nrp is string && data.nrp.size() >= 1 && data.nrp.size() <= 40 &&
             data.role in ['Danru Plot BPS', 'Anggota Pos Utama BPS', 'Anggota Patroli Gedung BPS', 'Korlap Security BPS'] &&
             data.activeShift in ['Shift 1', 'Shift 2', 'Shift 3'] &&
             (!('activeRoomCode' in data) || isValidRoomCode(data.activeRoomCode)) &&
             (!('onlineStatus' in data) || data.onlineStatus in ['online', 'offline']) &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 120000)) &&
             (!('lastSeenAt' in data) || (data.lastSeenAt is timestamp && data.lastSeenAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSecurityReport(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.category is int && data.category >= 1 && data.category <= 3 &&
             data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
             (!('reportDate' in data) || (data.reportDate is string && data.reportDate.size() == 10 && data.reportDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))) &&
             data.shift in ['Shift 1', 'Shift 2', 'Shift 3'] &&
             data.status in ['Aman & Terkendali', 'Dalam Pemantauan', 'Perlu Tindak Lanjut'] &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 2000 &&
             data.photos is list && data.photos.size() <= 4 &&
             (data.photos.size() == 0 || (data.photos[0] is string && data.photos[0].size() <= 200000)) &&
             (!('photoCaptions' in data) || (data.photoCaptions is list && data.photoCaptions.size() <= 4 && (data.photoCaptions.size() == 0 || (data.photoCaptions[0] is string && data.photoCaptions[0].size() <= 200)))) &&
             data.officerName is string && data.officerName.size() >= 1 && data.officerName.size() <= 80 &&
             data.officerNrp is string && data.officerNrp.size() >= 1 && data.officerNrp.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.senderRole is string && data.senderRole.size() >= 1 && data.senderRole.size() <= 80 &&
             data.fromOfficer is bool &&
             data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
             data.text is string && data.text.size() <= 2000 &&
             data.audioType in ['none', 'recorded', 'simulated'] &&
             (!('imageData' in data) || (data.imageData is string && data.imageData.size() <= 200000)) &&
             (!('imageCaption' in data) || (data.imageCaption is string && data.imageCaption.size() <= 300)) &&
             (!('audioData' in data) || (data.audioData is string && data.audioData.size() <= 250000)) &&
             (!('audioDuration' in data) || (data.audioDuration is string && data.audioDuration.size() <= 20)) &&
             (data.text.size() > 0 || ('imageData' in data && data.imageData.size() > 0) || data.audioType != 'none') &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChatRoom(data, roomCode) {
      return data.roomCode is string && data.roomCode == roomCode &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomMember(data, roomCode, userId) {
      return data.userId is string && data.userId == userId &&
             data.roomCode is string && data.roomCode == roomCode &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.nrp is string && data.nrp.size() >= 1 && data.nrp.size() <= 40 &&
             data.role in ['Danru Plot BPS', 'Anggota Pos Utama BPS', 'Anggota Patroli Gedung BPS', 'Korlap Security BPS'] &&
             data.activeShift in ['Shift 1', 'Shift 2', 'Shift 3'] &&
             data.onlineStatus in ['online', 'offline'] &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 120000)) &&
             data.lastSeenAt is timestamp && data.lastSeenAt <= request.time &&
             data.joinedAt is timestamp && data.joinedAt <= request.time;
    }

    function isValidRoomChatMessage(data, roomCode) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.roomCode is string && data.roomCode == roomCode &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.senderRole is string && data.senderRole.size() >= 1 && data.senderRole.size() <= 80 &&
             data.fromOfficer is bool &&
             data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
             data.text is string && data.text.size() <= 2000 &&
             data.audioType in ['none', 'recorded', 'simulated'] &&
             (!('imageData' in data) || (data.imageData is string && data.imageData.size() <= 200000)) &&
             (!('imageCaption' in data) || (data.imageCaption is string && data.imageCaption.size() <= 300)) &&
             (!('audioData' in data) || (data.audioData is string && data.audioData.size() <= 250000)) &&
             (!('audioDuration' in data) || (data.audioDuration is string && data.audioDuration.size() <= 20)) &&
             (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 120000)) &&
             (!('edited' in data) || data.edited is bool) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             (!('shift' in data) || data.shift in ['Shift 1', 'Shift 2', 'Shift 3']) &&
             (data.text.size() > 0 || ('imageData' in data && data.imageData.size() > 0) || data.audioType != 'none') &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidActivitySheet(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.docNumber is string && data.docNumber.size() <= 40 &&
             data.sheetDate is string && data.sheetDate.size() == 10 && data.sheetDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.shift in ['Shift 1', 'Shift 2', 'Shift 3'] &&
             data.personnelRows is list && data.personnelRows.size() <= 30 &&
             (data.personnelRows.size() == 0 || data.personnelRows[0] is map) &&
             data.inventoryRows is list && data.inventoryRows.size() <= 50 &&
             (data.inventoryRows.size() == 0 || data.inventoryRows[0] is map) &&
             data.activityRows is list && data.activityRows.size() <= 60 &&
             (data.activityRows.size() == 0 || data.activityRows[0] is map) &&
             data.officerName is string && data.officerName.size() >= 1 && data.officerName.size() <= 80 &&
             data.officerNrp is string && data.officerNrp.size() >= 1 && data.officerNrp.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAttendanceSheet(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.sheetDate is string && data.sheetDate.size() == 10 && data.sheetDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.shift in ['Shift 1', 'Shift 2', 'Shift 3'] &&
             data.periodLabel is string && data.periodLabel.size() <= 60 &&
             data.commanderName is string && data.commanderName.size() >= 1 && data.commanderName.size() <= 80 &&
             data.rows is list && data.rows.size() <= 25 &&
             (data.rows.size() == 0 || data.rows[0] is map) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPjuSheet(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.monthYear is string && data.monthYear.size() >= 1 && data.monthYear.size() <= 40 &&
             data.sheetMonth is int && data.sheetMonth >= 1 && data.sheetMonth <= 12 &&
             data.sheetYear is int && data.sheetYear >= 2020 && data.sheetYear <= 2100 &&
             data.periodStartDay is int && data.periodStartDay >= 1 && data.periodStartDay <= 31 &&
             data.periodEndDay is int && data.periodEndDay >= data.periodStartDay && data.periodEndDay <= 31 &&
             data.clusters is list && data.clusters.size() <= 40 &&
             (data.clusters.size() == 0 || data.clusters[0] is map) &&
             data.issues is list && data.issues.size() <= 100 &&
             (data.issues.size() == 0 || data.issues[0] is map) &&
             data.notes is string && data.notes.size() <= 2000 &&
             data.responsibleNames is string && data.responsibleNames.size() >= 1 && data.responsibleNames.size() <= 120 &&
             (!('lastShift' in data) || data.lastShift in ['Shift 1', 'Shift 2', 'Shift 3']) &&
             (!('lastUpdatedTime' in data) || (data.lastUpdatedTime is string && data.lastUpdatedTime.size() <= 16)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuickNote(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.sourceTab is string && data.sourceTab.size() >= 1 && data.sourceTab.size() <= 24 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.noteDate is string && data.noteDate.size() == 10 && data.noteDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.noteTime is string && data.noteTime.size() >= 4 && data.noteTime.size() <= 10 &&
             data.shift in ['Shift 1', 'Shift 2', 'Shift 3'] &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'name', 'nrp', 'role', 'activeShift', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'nrp', 'role', 'activeShift', 'activeRoomCode', 'onlineStatus', 'photoData', 'lastSeenAt', 'createdAt', 'updatedAt']) &&
                       isValidOfficerProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidOfficerProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nrp', 'role', 'activeShift', 'activeRoomCode', 'onlineStatus', 'photoData', 'lastSeenAt', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /reports/{reportId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(reportId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(reportId) &&
                         incoming().keys().hasAll(['userId', 'category', 'time', 'shift', 'status', 'description', 'photos', 'officerName', 'officerNrp', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'category', 'time', 'reportDate', 'shift', 'status', 'description', 'photos', 'photoCaptions', 'officerName', 'officerNrp', 'createdAt', 'updatedAt']) &&
                         isValidSecurityReport(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(reportId) &&
                         isValidSecurityReport(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'time', 'reportDate', 'shift', 'status', 'description', 'photos', 'photoCaptions', 'officerName', 'officerNrp', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(reportId);
      }

      match /chat_messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'senderName', 'senderRole', 'fromOfficer', 'time', 'text', 'audioType', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'senderName', 'senderRole', 'fromOfficer', 'time', 'text', 'imageData', 'imageCaption', 'audioType', 'audioData', 'audioDuration', 'createdAt']) &&
                         isValidChatMessage(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
      }

      match /activity_sheets/{sheetId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sheetId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sheetId) &&
                         incoming().keys().hasAll(['userId', 'docNumber', 'sheetDate', 'shift', 'personnelRows', 'inventoryRows', 'activityRows', 'officerName', 'officerNrp', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'docNumber', 'sheetDate', 'shift', 'personnelRows', 'inventoryRows', 'activityRows', 'officerName', 'officerNrp', 'createdAt', 'updatedAt']) &&
                         isValidActivitySheet(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sheetId) &&
                         isValidActivitySheet(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['docNumber', 'sheetDate', 'shift', 'personnelRows', 'inventoryRows', 'activityRows', 'officerName', 'officerNrp', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sheetId);
      }

      match /attendance_sheets/{sheetId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sheetId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sheetId) &&
                         incoming().keys().hasAll(['userId', 'sheetDate', 'shift', 'periodLabel', 'commanderName', 'rows', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'sheetDate', 'shift', 'periodLabel', 'commanderName', 'rows', 'createdAt', 'updatedAt']) &&
                         isValidAttendanceSheet(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sheetId) &&
                         isValidAttendanceSheet(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['sheetDate', 'shift', 'periodLabel', 'commanderName', 'rows', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sheetId);
      }

      match /pju_sheets/{sheetId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sheetId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sheetId) &&
                         incoming().keys().hasAll(['userId', 'monthYear', 'sheetMonth', 'sheetYear', 'periodStartDay', 'periodEndDay', 'clusters', 'issues', 'notes', 'responsibleNames', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'monthYear', 'sheetMonth', 'sheetYear', 'periodStartDay', 'periodEndDay', 'clusters', 'issues', 'notes', 'responsibleNames', 'lastShift', 'lastUpdatedTime', 'createdAt', 'updatedAt']) &&
                         isValidPjuSheet(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sheetId) &&
                         isValidPjuSheet(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['monthYear', 'sheetMonth', 'sheetYear', 'periodStartDay', 'periodEndDay', 'clusters', 'issues', 'notes', 'responsibleNames', 'lastShift', 'lastUpdatedTime', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sheetId);
      }

      match /quick_notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll(['userId', 'sourceTab', 'title', 'content', 'noteDate', 'noteTime', 'shift', 'authorName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'sourceTab', 'title', 'content', 'noteDate', 'noteTime', 'shift', 'authorName', 'createdAt', 'updatedAt']) &&
                         isValidQuickNote(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(noteId) &&
                         isValidQuickNote(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['sourceTab', 'title', 'content', 'noteDate', 'noteTime', 'shift', 'authorName', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }
    }

    match /chat_rooms/{roomCode} {
      allow get: if isSignedIn() && isValidRoomCode(roomCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidRoomCode(roomCode) &&
                       incoming().keys().hasAll(['roomCode', 'title', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['roomCode', 'title', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().createdBy == request.auth.uid &&
                       isValidChatRoom(incoming(), roomCode);

      allow update: if isSignedIn() &&
                       isValidRoomCode(roomCode) &&
                       existing().createdBy == request.auth.uid &&
                       isValidChatRoom(incoming(), roomCode) &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);

      allow delete: if false;

      match /members/{userId} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && isValidId(userId);
        allow list: if isSignedIn() && isValidRoomCode(roomCode) && existing().roomCode == roomCode;

        allow create: if isOwner(userId) &&
                         isValidRoomCode(roomCode) &&
                         isValidId(userId) &&
                         incoming().keys().hasAll(['userId', 'roomCode', 'name', 'nrp', 'role', 'activeShift', 'onlineStatus', 'lastSeenAt', 'joinedAt']) &&
                         incoming().keys().hasOnly(['userId', 'roomCode', 'name', 'nrp', 'role', 'activeShift', 'onlineStatus', 'photoData', 'lastSeenAt', 'joinedAt']) &&
                         isValidRoomMember(incoming(), roomCode, userId) &&
                         exists(/databases/$(database)/documents/chat_rooms/$(roomCode));

        allow update: if isOwner(userId) &&
                         isValidRoomCode(roomCode) &&
                         isValidId(userId) &&
                         isValidRoomMember(incoming(), roomCode, userId) &&
                         incoming().userId == existing().userId &&
                         incoming().roomCode == existing().roomCode &&
                         incoming().joinedAt == existing().joinedAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nrp', 'role', 'activeShift', 'onlineStatus', 'photoData', 'lastSeenAt']);

        allow delete: if isOwner(userId) && isValidRoomCode(roomCode) && isValidId(userId);
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && isValidId(messageId);
        allow list: if isSignedIn() && isValidRoomCode(roomCode) && existing().roomCode == roomCode;

        allow create: if isSignedIn() &&
                         isValidRoomCode(roomCode) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'roomCode', 'senderName', 'senderRole', 'fromOfficer', 'time', 'text', 'audioType', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'roomCode', 'senderName', 'senderRole', 'fromOfficer', 'time', 'text', 'imageData', 'imageCaption', 'audioType', 'audioData', 'audioDuration', 'senderPhoto', 'shift', 'edited', 'updatedAt', 'createdAt']) &&
                         isValidRoomChatMessage(incoming(), roomCode) &&
                         exists(/databases/$(database)/documents/chat_rooms/$(roomCode));

        allow update: if isSignedIn() &&
                         isValidRoomCode(roomCode) &&
                         isValidId(messageId) &&
                         existing().userId == request.auth.uid &&
                         isValidRoomChatMessage(incoming(), roomCode) &&
                         incoming().userId == existing().userId &&
                         incoming().roomCode == existing().roomCode &&
                         incoming().senderName == existing().senderName &&
                         incoming().senderRole == existing().senderRole &&
                         incoming().fromOfficer == existing().fromOfficer &&
                         incoming().time == existing().time &&
                         incoming().audioType == existing().audioType &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'imageCaption', 'edited', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidRoomCode(roomCode) &&
                         isValidId(messageId) &&
                         (existing().userId == request.auth.uid ||
                          get(/databases/$(database)/documents/chat_rooms/$(roomCode)).data.createdBy == request.auth.uid);
      }
    }
  }
}
