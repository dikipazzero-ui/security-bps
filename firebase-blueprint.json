{
  "entities": {
    "OfficerProfile": {
      "title": "OfficerProfile",
      "description": "Profil petugas security Plot BPS yang aktif bertugas.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID pemilik profil"
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap petugas security"
        },
        "nrp": {
          "type": "string",
          "description": "NRP atau nomor ID anggota security"
        },
        "role": {
          "type": "string",
          "enum": [
            "Danru Plot BPS",
            "Anggota Pos Utama BPS",
            "Anggota Patroli Gedung BPS",
            "Korlap Security BPS"
          ],
          "description": "Jabatan atau plot tugas di lingkungan BPS"
        },
        "activeShift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Shift tugas aktif saat ini"
        },
        "activeRoomCode": {
          "type": "string",
          "description": "Kode ruang Live Chat yang sedang diikuti (opsional)"
        },
        "onlineStatus": {
          "type": "string",
          "enum": ["online", "offline"],
          "description": "Status koneksi online petugas (opsional)"
        },
        "photoData": {
          "type": "string",
          "description": "Foto profil petugas terkompresi base64 JPEG (opsional)"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu aktivitas online terakhir (FieldValue.serverTimestamp())"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan profil (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "name",
        "nrp",
        "role",
        "activeShift",
        "createdAt",
        "updatedAt"
      ]
    },
    "SecurityReport": {
      "title": "SecurityReport",
      "description": "Rincian laporan harian security Plot BPS dalam salah satu dari 3 kategori wajib.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID petugas pembuat laporan"
        },
        "category": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "Kategori laporan: 1 (Apel & Inventaris), 2 (Patroli BPS), 3 (Pelayanan Tamu & Kamtibmas)"
        },
        "time": {
          "type": "string",
          "description": "Waktu pelaksanaan kegiatan (format HH:mm)"
        },
        "reportDate": {
          "type": "string",
          "description": "Tanggal laporan format yyyy-MM-dd untuk penyaringan hari/bulan/tahun"
        },
        "shift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Keterangan shift pelaksanaan tugas"
        },
        "status": {
          "type": "string",
          "enum": [
            "Aman & Terkendali",
            "Dalam Pemantauan",
            "Perlu Tindak Lanjut"
          ],
          "description": "Status kondisi lapangan"
        },
        "description": {
          "type": "string",
          "description": "Rincian kegiatan atau kejadian lapangan"
        },
        "photos": {
          "type": "array",
          "description": "Maksimal 4 foto dokumentasi terkompresi dalam format base64 JPEG"
        },
        "photoCaptions": {
          "type": "array",
          "description": "Keterangan masing-masing foto dokumentasi (maksimal 4 item)"
        },
        "officerName": {
          "type": "string",
          "description": "Nama petugas pelapor"
        },
        "officerNrp": {
          "type": "string",
          "description": "NRP/ID petugas pelapor"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan laporan (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan laporan (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "category",
        "time",
        "shift",
        "status",
        "description",
        "photos",
        "officerName",
        "officerNrp",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Pesan teks, foto kondisi beserta keterangan, atau voice note di ruang Live Chat.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID pengirim pesan"
        },
        "roomCode": {
          "type": "string",
          "description": "Kode ruang Live Chat tempat pesan dikirim"
        },
        "senderName": {
          "type": "string",
          "description": "Nama pengirim pesan"
        },
        "senderRole": {
          "type": "string",
          "description": "Plot atau jabatan pengirim pesan"
        },
        "fromOfficer": {
          "type": "boolean",
          "description": "Penanda pesan dikirim oleh petugas"
        },
        "time": {
          "type": "string",
          "description": "Jam pengiriman pesan (format HH:mm)"
        },
        "text": {
          "type": "string",
          "description": "Isi pesan teks koordinasi"
        },
        "imageData": {
          "type": "string",
          "description": "Lampiran foto terkompresi base64 JPEG (opsional)"
        },
        "imageCaption": {
          "type": "string",
          "description": "Keterangan foto yang dilampirkan pada pesan chat (opsional)"
        },
        "audioType": {
          "type": "string",
          "enum": ["none", "recorded", "simulated"],
          "description": "Jenis lampiran voice note"
        },
        "audioData": {
          "type": "string",
          "description": "Data audio voice note terkompresi base64 M4A (opsional)"
        },
        "audioDuration": {
          "type": "string",
          "description": "Durasi voice note format MM:SS (opsional)"
        },
        "senderPhoto": {
          "type": "string",
          "description": "Foto profil pengirim pesan base64 JPEG (opsional)"
        },
        "shift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Shift aktif pengirim pesan saat chat dikirim (opsional)"
        },
        "edited": {
          "type": "boolean",
          "description": "Penanda pesan pernah diedit (opsional)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp terakhir pesan diedit (opsional)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server pengiriman pesan (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "senderName",
        "senderRole",
        "fromOfficer",
        "time",
        "text",
        "audioType",
        "createdAt"
      ]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Ruang koordinasi Live Chat multi-petugas yang diakses dengan kode ruang tertentu.",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "description": "Kode unik ruang koordinasi (contoh: PLOT-BPS)"
        },
        "title": {
          "type": "string",
          "description": "Nama ruang koordinasi"
        },
        "createdBy": {
          "type": "string",
          "description": "Firebase Auth UID pembuat ruang"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan ruang (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan ruang (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "roomCode",
        "title",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomMember": {
      "title": "RoomMember",
      "description": "Profil dan status online real-time anggota dalam ruang Live Chat.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID anggota"
        },
        "roomCode": {
          "type": "string",
          "description": "Kode ruang Live Chat"
        },
        "name": {
          "type": "string",
          "description": "Nama petugas"
        },
        "nrp": {
          "type": "string",
          "description": "NRP petugas"
        },
        "role": {
          "type": "string",
          "enum": [
            "Danru Plot BPS",
            "Anggota Pos Utama BPS",
            "Anggota Patroli Gedung BPS",
            "Korlap Security BPS"
          ],
          "description": "Jabatan petugas"
        },
        "activeShift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Shift aktif petugas"
        },
        "onlineStatus": {
          "type": "string",
          "enum": ["online", "offline"],
          "description": "Status kehadiran online di aplikasi"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu heartbeat online terakhir (FieldValue.serverTimestamp())"
        },
        "photoData": {
          "type": "string",
          "description": "Foto profil anggota ruang chat terkompresi base64 JPEG (opsional)"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu bergabung ke ruang (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "roomCode",
        "name",
        "nrp",
        "role",
        "activeShift",
        "onlineStatus",
        "lastSeenAt",
        "joinedAt"
      ]
    },
    "DailyActivitySheet": {
      "title": "DailyActivitySheet",
      "description": "Lembar tabel pelaporan kegiatan harian Security Plot BPS berisi tabel personel, inventaris, dan uraian kegiatan per jam.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID pemilik lembar tabel"
        },
        "docNumber": {
          "type": "string",
          "description": "Nomor dokumen lembar laporan (opsional)"
        },
        "sheetDate": {
          "type": "string",
          "description": "Tanggal lembar kegiatan format yyyy-MM-dd"
        },
        "shift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Shift bertugas pada lembar tabel"
        },
        "personnelRows": {
          "type": "array",
          "description": "Daftar baris tabel personel (nama, jabatan, plot, kehadiran, ket)"
        },
        "inventoryRows": {
          "type": "array",
          "description": "Daftar baris tabel inventaris pos (inventaris, jumlah, kondisi, keterangan)"
        },
        "activityRows": {
          "type": "array",
          "description": "Daftar baris tabel uraian kegiatan per jam (jam, uraian)"
        },
        "officerName": {
          "type": "string",
          "description": "Nama petugas penyusun lembar"
        },
        "officerNrp": {
          "type": "string",
          "description": "NRP petugas penyusun lembar"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan lembar (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "docNumber",
        "sheetDate",
        "shift",
        "personnelRows",
        "inventoryRows",
        "activityRows",
        "officerName",
        "officerNrp",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceSheet": {
      "title": "AttendanceSheet",
      "description": "Lembar tabel absensi harian untuk 15 anggota Security Plot BPS lengkap dengan status kehadiran, jam masuk/pulang, dan waktu rekam.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID pemilik lembar absensi"
        },
        "sheetDate": {
          "type": "string",
          "description": "Tanggal absensi format yyyy-MM-dd"
        },
        "shift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Shift absensi"
        },
        "periodLabel": {
          "type": "string",
          "description": "Keterangan regu / periode absensi"
        },
        "commanderName": {
          "type": "string",
          "description": "Nama Danru / penanggung jawab absensi"
        },
        "rows": {
          "type": "array",
          "description": "Daftar 15 baris absensi anggota (nama, nrp, jabatan, plot, status, jamMasuk, jamPulang, recordedAt, keterangan)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan lembar absensi (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "sheetDate",
        "shift",
        "periodLabel",
        "commanderName",
        "rows",
        "createdAt",
        "updatedAt"
      ]
    },
    "PjuChecklistSheet": {
      "title": "PjuChecklistSheet",
      "description": "Lembar Form Checklist Penerangan Jalan Umum (PJU) Perumahan Bumi Papan Selaras per periode bulan & tanggal (maksimal 2 hari sekali).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID pemilik lembar PJU"
        },
        "monthYear": {
          "type": "string",
          "description": "Nama bulan & tahun checklist (contoh: November 2026)"
        },
        "sheetMonth": {
          "type": "integer",
          "description": "Bulan numerik (1-12) untuk filter berkala"
        },
        "sheetYear": {
          "type": "integer",
          "description": "Tahun numerik untuk filter berkala"
        },
        "periodStartDay": {
          "type": "integer",
          "description": "Tanggal awal periode kolom checklist (1-31)"
        },
        "periodEndDay": {
          "type": "integer",
          "description": "Tanggal akhir periode kolom checklist (1-31)"
        },
        "clusters": {
          "type": "array",
          "description": "Daftar cluster PJU (NO 1-9 standar: Krisan, Cempaka, Cendana, Cemara, Flamboyan 1, Flamboyan 2, Flamboyan Fasum, Akasia, Ruko) beserta map status per tanggal (4 titik lampu per baris)"
        },
        "issues": {
          "type": "array",
          "description": "Daftar permasalahan PJU yang wajib diisi bila saat pengecekan ditemukan kendala"
        },
        "notes": {
          "type": "string",
          "description": "Kolom CATATAN lembar checklist PJU"
        },
        "responsibleNames": {
          "type": "string",
          "description": "Penanggung Jawab PJU (default: R. MOH. GANDI / NERI WELAS ANTORO)"
        },
        "lastShift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Shift petugas terakhir yang mencatat/menyimpan checklist PJU (opsional)"
        },
        "lastUpdatedTime": {
          "type": "string",
          "description": "Jam pembaruan terakhir format HH:mm (opsional)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan lembar PJU (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "monthYear",
        "sheetMonth",
        "sheetYear",
        "periodStartDay",
        "periodEndDay",
        "clusters",
        "issues",
        "notes",
        "responsibleNames",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuickNote": {
      "title": "QuickNote",
      "description": "Catatan petugas security yang disimpan per opsi dengan stempel waktu dan shift.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID pemilik catatan"
        },
        "sourceTab": {
          "type": "string",
          "description": "Asal opsi pencatatan (Laporan, Tabel, Absensi, PJU, Chat, Catatan)"
        },
        "title": {
          "type": "string",
          "description": "Judul singkat catatan"
        },
        "content": {
          "type": "string",
          "description": "Isi catatan lapangan"
        },
        "noteDate": {
          "type": "string",
          "description": "Tanggal catatan format yyyy-MM-dd"
        },
        "noteTime": {
          "type": "string",
          "description": "Jam catatan format HH:mm"
        },
        "shift": {
          "type": "string",
          "enum": ["Shift 1", "Shift 2", "Shift 3"],
          "description": "Shift bertugas saat catatan disimpan"
        },
        "authorName": {
          "type": "string",
          "description": "Nama petugas pembuat catatan"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server pembuatan catatan"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server pembaruan catatan"
        }
      },
      "required": [
        "userId",
        "sourceTab",
        "title",
        "content",
        "noteDate",
        "noteTime",
        "shift",
        "authorName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/OfficerProfile"
      },
      "description": "Profil dan shift aktif petugas security Plot BPS"
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/SecurityReport"
      },
      "description": "Daftar laporan harian security milik petugas"
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Riwayat chat pribadi (legacy)"
    },
    "/chat_rooms/{roomCode}": {
      "schema": {
        "$ref": "#/entities/ChatRoom"
      },
      "description": "Ruang Live Chat berbasis kode akses untuk koordinasi real-time antar petugas"
    },
    "/chat_rooms/{roomCode}/members/{userId}": {
      "schema": {
        "$ref": "#/entities/RoomMember"
      },
      "description": "Daftar anggota dan status online real-time dalam ruang Live Chat"
    },
    "/chat_rooms/{roomCode}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Pesan teks, foto berketerangan, dan Voice Note dalam ruang Live Chat"
    },
    "/users/{userId}/activity_sheets/{sheetId}": {
      "schema": {
        "$ref": "#/entities/DailyActivitySheet"
      },
      "description": "Lembar tabel pelaporan kegiatan (Personel, Inventaris, dan Uraian Kegiatan per jam)"
    },
    "/users/{userId}/attendance_sheets/{sheetId}": {
      "schema": {
        "$ref": "#/entities/AttendanceSheet"
      },
      "description": "Lembar tabel absensi 15 anggota Security Plot BPS"
    },
    "/users/{userId}/pju_sheets/{sheetId}": {
      "schema": {
        "$ref": "#/entities/PjuChecklistSheet"
      },
      "description": "Lembar Form Checklist Penerangan Jalan Umum (PJU) Perumahan Bumi Papan Selaras"
    },
    "/users/{userId}/quick_notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/QuickNote"
      },
      "description": "Catatan cepat petugas security lengkap dengan tanggal, jam, dan shift"
    }
  }
}
